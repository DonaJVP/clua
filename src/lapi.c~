std::vector<Values> Lua::callLuaFunction(lua_Table *tbl, const lua_IndexMethod funcid, std::vector<Values> args) { // Let's remember that lua code are transformed into ASM code
	//FunctionPointer fn = nullptr;
	Values *index = nullptr;
	// Get the function (Not sure but if a c function are stored here it can be executed back again lol)
	try {
		if (funcid.idx_typo == _lua_idxm_string)
			index = tbl->Node->getValueAddr(funcid.idx_str_h);
		else
			index = tbl->Node->getRawAddrValueIDX(funcid.idx_int);
		// Should we check if the function are valid? Obviously not if we register in on other table.....
	} catch (std::out_of_range &e) {
		// Oops! We might found a misundertanding sir! We will report this case
		// First, let's check if the function was registered so we can get its real name
		m_LuaErrorHandler->reportError(_lua_es_ValueIsNil, ((funcid.idx_typo == _lua_idxm_string) ? funcid.idx_str_h : funcid.idx_int));
		if ((funcid.idx_typo == _lua_idxm_string) && tbl->Node->getAddrInfo(funcid)) {
			// Seems it was registered, but deleted.
			lua_VarOnMemInfo *ai = tbl->Node->getAddrInfo(funcid);
			m_LuaErrorHandler->reportError(_lua_es_ArgIsProblem, funcid.idx_str_h, std::string("FuncID equals to: " + ai->varname + "; Type=" + ((int)ai->type)))
		} else {
			//m_LuaErrorHandler->reportError(_lua_es_ArgIsProblem, funcid, std::string("FuncID")) //Could not report something that is in a idx, also, it already was reported.
		}
		return std::vector<Values>;
	}
	// We found, first, verify the data
	if (index->TYPO != LuaFunction) {
		m_LuaErrorHandler->reportError(_lua_es_NonFunction, ((funcid.idx_typo == _lua_idxm_string) ? funcid.idx_str_h : funcid.idx_int), std::string("FuncID equals to: " + ai->varname + "; Type=" + ((int)ai->type)));
		return;
	}
	FunctionPointer func = index->val4;
	return func(args);
}

