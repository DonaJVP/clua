	// Declare Keys						//				|						| ***						| 
	_L_FUNCTION				=	1,		// function		|	__func				| 001						| 001 "Example"()
	_L_LOCAL				=	2,		// local		|	__onThisSector		| 002						| 002 "a_variable" <A raw lua value>
	_L_WHILE				=	3,		// while		|	__loop				| 003						| 003 <A raw lua value, shouln't be a string or number or else: true> "\n"
	_L_UNTIL				=	4,		// until		|	__cancelOn			| 004						| B} 004
	_L_FOR					=	5,		// for			|	__getElements		| 005						| 005 B{<007>
	_L_REPEAT				=	6,		// repeat		|	__loop_until		| 006						| 006 B{<007>
	// Misc								//				|						| ***						|
