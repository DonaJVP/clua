LuaLexFrame LuaLex::resolveCommandString(std::vector<uint8_t> *data, std::string __cmd, uint64_t pos) {
	_Lua_Lex_Keys _KEY = _L_MAX;
	uint8_t range = 0;
	bool got = false;
	__CheckSect: { // Range selector
		if (!got)
			goto __MAIN_PROC;
		switch (range) {
			// Execution spaces
			case ((range >= 0) && (range < 3)): { // function sector
				_KEY = _L_FUNCTION;
				break;
			}
			case ((range >= 3) && (range < 6)): { // local sector
				_KEY = _L_LOCAL;
				break
			}
			case ((range >= 6) && (range < 9)): { // while sector
				_KEY = _L_WHILE;
				break
			}
			case ((range >= 9) && (range < 12)): { // until sector
				_KEY = _L_UNTIL;
				break
			}
			case ((range >= 12) && (range < 15)): { // for sector
				_KEY = _L_FOR;
				break
			}
			case ((range >= 15) && (range < 18)): { // repeat sector
				_KEY = _L_REPEAT;
				break
			}
			
			// Naming spaces
			case ((range >= 18) && (range < 20)): { // bool sector
				_KEY = _L_BOOL;
				break
			}
			case ((range >= 20) && (range < 22)): { // int sector
				_KEY = _L_INT;
				break
			}
			case ((range >= 22) && (range < 24)): { // string sector
				_KEY = _L_STRING2;
				break
			}
			
			// Logical spaces
			case ((range >= 24) && (range < 27)): { // do sector
				_KEY = _L_BlockStart;
				break
			}
			case ((range >= 27) && (range < 30)): { // end sector
				_KEY = _L_BlockEnd;
				break
			}
			case ((range >= 30) && (range < 33)): { // and sector
				_KEY = _L_AND;
				break
			}
			case ((range >= 33) && (range < 36)): { // else sector
				_KEY = _L_ELSE;
				break
			}
			case ((range >= 36) && (range < 39)): { // elseif sector
				_KEY = _L_ELSEIF;
				break
			}
			case ((range >= 39) && (range < 42)): { // or sector
				_KEY = _L_OR;
				break
			}
			case ((range >= 42) && (range < 44)): { // if sector
				_KEY = _L_IF;
				break
			}
			case ((range >= 44) && (range < 46)): { // then sector
				_KEY = _L_THEN;
				break
			}
			case ((range >= 46) && (range < 49)): { // break sector
				_KEY = _L_BREAK;
				break
			}
			case ((range >= 49) && (range < 51)): { // in sector
				_KEY = _L_IN;
				break
			}
			case ((range >= 51) && (range < 53)): { // nil sector
				_KEY = _L_NIL;
				break
			}
			case ((range >= 53) && (range < 56)): { // not sector
				_KEY = _L_NOT;
				break
			}
			case ((range >= 56) && (range < 58)): { // return sector
				_KEY = _L_RETURN;
				break
			}
			
			// Values space
			case ((range >= 58) && (range < 61)): { // elseif sector
				_KEY = _L_TRUE;
				break
			}
			case ((range >= 61) && (range < 64)): { // elseif sector
				_KEY = _L_FALSE;
				break
			}
			
			// Special values that won't fit
			case ((range >= 64) && (range < 68)): { // elseif sector
				switch (range) {
					case (64): {
						_KEY = _L_NUMBER;
						break
					}
					case (65): {
						_KEY = _L_STRING;
						break
					}
					case (66): {
						_KEY = _L_VARNAME;
						break
					}
					case (67): {
						_KEY = _L_EOF;
						break
					}
				}
				break
			}
			
			// Logical spaces
			case ((range >= 68) && (range < 71)): { // elseif sector
				_KEY = _L_CONCAT;
				break
			}
			case ((range >= 71) && (range < 74)): { // elseif sector
				_KEY = _L_MULTIPLEARGS;
				break
			}
			case ((range >= 74) && (range < 76)): { // elseif sector
				_KEY = _L_EQUALS;
				break
			}
			case ((range >= 76) && (range < 79)): { // elseif sector
				_KEY = _L_EQUALS_OR_MORE;
				break
			}
			case ((range >= 79) && (range < 82)): { // elseif sector
				_KEY = _L_EQUALS_OR_MINUS;
				break
			}
			case ((range >= 82) && (range < 85)): { // elseif sector
				_KEY = _L_DOENST_EQUALS;
				break
			}
			// case _L_MAX is not seen.
		}
	}
	
	__MAIN_PROC: 
	
	// Let's search that word
	// NOTE: The pos should be at the position 0 of the selected word, like this [V]ar1
	
	for (std::string keyword : _LuaKeysString) {
		if (keyword == __cmd) {
			got = true;
			goto __CheckSect;
			break;
		} else {
			range++;
		}
	}
	
	if (got) {
		return LuaLexFrame(_KEY);
	} else {
		// Huh? if not found then it should be a declaration
		// Well, now we will check the pos
		//std::vector<uint8_t>::iterator it;
		//for (it = data.begin()+(pos-1); it != data.end(); it++) { // Start in position, minus 1
			
		//}
		
		//Return a special key
		LuaLexFrame key = LuaLexFrame(_L_DECLR);
		key.header = __cmd;
		return key;
	}
}

void LuaLex::readDataAndloadToLua(std::vector<uint8_t> data) {
	// Read contents and parse
	std::vector<LuaLexFrame> _BLOCKS;
	std::vector<std::string> _WORDS_CACHE;
	
	// Lexical checkers
	std::pair<bool, uint32_t> PR_str = std::make_pair(false, 0);
	bool PR_brk = false;
	bool PR_blk = false;
	bool PR_jmp = false;
	bool PR_cmt = false;
	bool PR_bcm = false;
	bool PR_dfn = false;
	
	uint16_t actual_line = 0;
	uint64_t pos = 0;
	uint32_t last_ProcWordLen = 0;
	
	bool _proc = false;
	_PROC_WORD: {
		if (_proc) {
			LuaLexFrame block = resolveCommandString(&data, std::string(&data[pos], last_ProcWordLen), pos);
			_BLOCKS.push_back(block);
		}
	}
	//Sector _PROC_WORD;
	
	bool PR_passed_thr = false;
	
	// Show the strings
	std::string cache;
	for (uint8_t &byte: data) {
		if ((byte == ' ') || (byte == '{') || (byte == '}') || (byte == '[') || (byte == ']') || (byte == '(') || (byte == ')')) {
			if (cache.size() > 0) {
				_WORDS_CACHE.push_back(cache);
				cache.clear();
			}
		} else {
			cache.append(byte);
		}
	}
	
	for (uint8_t &byte : data) {
		switch (byte) {
			case '\n': {
				if (PR_str.first) { // Unfinished string
					m_LuaErrorHandler->reportError(_lua_es_BadString, 0, std::string("Bad string formed on line: " + std::string(actual_line)));
					m_LuaErrorHandler->setFatal(true);
				}
				actual_line++;
				
				PR_cmt = false;
				break;
			}
			
			// Special case
			case 'B': {
				// A block, opening or closing
				if ((data.at(pos+1) == "{") || (data.at(pos+1) == "}")) {
					pos++;
					PR_blk = (data.at(pos+1) == "{"); // If not that character then it are false, YOU'LL SEE.
					continue;
				}
			}
			
			case '[': { // If double [[ it should've an big comment or a [[BIG TEXT]] sector
				if (PR_str.first)
					goto __SectDef;
				else if (PR_cmt) { // Let's see the next 2 bytes.
					//Now our pos are [, lets check the next character
					if (data.at(pos+1) == "[") { // It's a [[BIG COMMENT]]
						PR_bcm = true;
						pos++;
						continue;
					}
				}
				// It might be other thing...
				
				break;
			}
			case ']': {
				if (data.at(pos+1) == "]") {
					if (PR_bcm) {
						PR_bcm = false;
						// the [[BIG COMMENT]] ends here
					}
					pos++;
					continue;
				}
			}
			case '-': {
				if (data.at(pos+1) == "-") { // It are a full comment or a decrement on a var
					if (last_ProcWordLen <= 0) {
						pos++;
						PR_cmt = true;
						continue;
					} else {
						// Is a variable, so decrement that
						std::string variablename = std::string(&data[pos], last_ProcWordLen);
						last_ProcWordLen = 0;
						LuaLexFrame _frm = LuaLexFrame(_L_DECREMENT_VARNUM);
						_frm.header = variablename;
						// _frm._data doens't require data
						_BLOCKS.push_back(_frm);
					}
				}
			}
			case ' ': {
				if (PR_str.first || PR_cmt || PR_bcm)
					goto __SectDef;
					
				// Let's consider the space is ignored in programming, hehe.
				// Unless is a comment, or this: wellthisisa[[BIGCOMMENT]]
				// BUT SOMETIMES
				
				_WORDS_CACHE.push_back(std::string(&data[pos], last_ProcWordLen));
				last_ProcWordLen = 0;
				break;
			}
			case '(': {
				if (PR_str.first || PR_cmt || PR_bcm)
					goto __SectDef;
				
				// This should be used like this
				// func()
				// ]("hi")
				// ("huh" ...
				
				if (*(_WORDS_CACHE.end()-1) == "function") { // We're defining a function, like this: function HALLOTHERE (
					
				}
				
				break;
			}
			case '.': { // _L_ON_TO_GO | _L_CONCAT | _L_MULTIPLEARGS
				if (PR_str.first || PR_cmt || PR_bcm)
					goto __SectDef;
				break;
			}
			
			case '{': {
				if (PR_str.first || PR_cmt || PR_bcm)
					goto __SectDef;
				break;
			}
			case '"': { // Start/End of a string
				if (PR_cmt || PR_bcm)
					goto __SectDef;
				
				if (!PR_str.first) { //Start
					PR_str.first = true;
					PR_str.second = pos;
				} else {
					// Manage to extract this part of string
					
					std::string _str = std::string(&data[PR_str.second], last_ProcWordLen);
					
					// Close string
					PR_str.first = false;
					PR_str.second = 0;
					
					// Push
					LuaLexFrame _frm = LuaLexFrame(_L_STRING);
					memcpy(&_frm._data[0], &data[pos], (size_t)last_ProcWordLen);
					_BLOCKS.push_back(_frm);
				}
				break;
			}
			case ''': {
				if (PR_str.first)
					goto __SectDef;
				break;
			}
__SectEq:
			case '=': {
				if (PR_str.first)
					goto __SectDef;
				break;
			}
__SectDef:
			default: {
				// Must be other characters
				last_ProcWordLen++;
			}
		}
		pos++;
	}
