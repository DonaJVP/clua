// Set nil an place of the vm [ Equals to a NULL or nullptr ]
void Lua::setNil(lua_Table *tbl, const lua_IndexMethod place) { //place should already be hashed here
	Values *nil = new Values();
	nil->TYPO = LuaNil;
	
	lua_AddrSpec addr;
	addr.Addr = (place.idx_typo == _lua_idxm_string) ? place.idx_str_h : NULL;
	addr.Addr2 = (place.idx_typo == _lua_idxm_integer) ? place.idx_int : NULL;
	
	// Check if theres an assigned value so we can clear it safely
	if (place.idx_typo == _lua_idxm_string && tbl->Node->getValueAddr(place.idx_str_h) != nullptr) { // Index is a string
		if (tbl->Node->getValueAddr(place.idx_str_h)->TYPO == LuaTable) {
			// Must clear table contents
			tbl->Node->getValueAddr(place.idx_str_h)->val3->clearTable();
			delete tbl->Node->getValueAddr(place.idx_str_h);
		} else {
			// Unlink & delete (Don't delete references, as it would help the developer to debug the accidental deletions)
			switch (tbl->Node->getValueAddr(place.idx_str_h)->TYPO) {
				case (LuaInteger || LuaString): {
					// Just delete
					delete tbl->Node->getValueAddr(place.idx_str_h);
					break;
				}
				case (LuaFunction): {
					delete tbl->Node->getValueAddr(place.idx_str_h)->val4;
					delete tbl->Node->getValueAddr(place.idx_str_h);
					break;
				}
				case (LuaObject): {
					delete tbl->Node->getValueAddr(place.idx_str_h)->val2; // Dangerous
				}
				case (LuaTable): {
					m_LuaErrorHandler->reportWarning("For some reason the code did magic ignoring some coding rules >:v"); // The code should be modified to get here
					break;
				} 
				case (LuaUsertype): {
					// Idk how to deal with this
				}
			}
		}
	} else if (place.idx_typo == _lua_idxm_integer && tbl->Node->getRawAddrValueIDX(place.idx_int) != nullptr) { //Index is an number
		if (tbl->Node->getRawAddrValueIDX(place.idx_int)->TYPO == LuaTable) {
			// Must clear table contents
			tbl->Node->getRawAddrValueIDX(place.idx_int)->val3->clearTable();
			delete tbl->Node->getRawAddrValueIDX(place.idx_int);
		} else {
			// Unlink & delete (Don't delete references, as it would help the developer to debug the accidental deletions)
			switch (tbl->Node->getRawAddrValueIDX(place.idx_int)->TYPO) {
				case (LuaInteger || LuaString): {
					// Just delete
					delete tbl->Node->getRawAddrValueIDX(place.idx_int);
					break;
				}
				case (LuaFunction): {
					delete tbl->Node->getRawAddrValueIDX(place.idx_int)->val4;
					delete tbl->Node->getRawAddrValueIDX(place.idx_int);
					break;
				}
				case (LuaObject): {
					delete tbl->Node->getRawAddrValueIDX(place.idx_int)->val2; // Dangerous
				}
				case (LuaTable): {
					m_LuaErrorHandler->reportWarning("For some reason the code did magic ignoring some coding rules >:v"); // The code should be modified if it gets here
					break;
				} 
				case (LuaUsertype): {
					// Idk how to deal with this
				}
			}
		}
	}
	tbl->setValue(addr, nil);
}

